    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vite": "6.4.2",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "xrpl": "^4.6.0"
  }
