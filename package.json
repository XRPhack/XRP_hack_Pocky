{
  "name": "nomokdon-local-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "tsc && vite build",
