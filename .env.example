# Local-only example. Copy to .env.local or pull encrypted values with Vercel CLI.
# Real .env files are gitignored; do not commit seeds, passwords, or keys.

# Required for issuer console login in local/dev/prod when using /issuer/.
ISSUER_CONSOLE_PASSWORD=

# Required only when live Testnet signing is intentionally enabled.
ISSUER_SEED=

# Optional. Current XRPL client code uses the fixed Testnet endpoint below.
XRPL_TESTNET_WS=wss://s.altnet.rippletest.net:51233

# Optional. Keep unset or false for dry-run demo mode.
NOMOKDON_ENABLE_LIVE_SUBMIT=false
XRPL_NETWORK=testnet

# Optional. 32-byte AES-256-GCM key for encrypted in-memory report storage.
# Accepted formats include raw 32-byte UTF-8, hex:..., base64:..., or utf8:...
VC_ENCRYPTION_KEY=

# Optional dry-run display address when no issuer seed is configured.
ISSUER_ADDRESS=
